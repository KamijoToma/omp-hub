{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "include": ["src", "test", "types", "scripts"]
}
